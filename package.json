{
  "name": "slm-sequence-compiler",
  "version": "0.1.0",
  "description": "Deterministic atom rearrangement and phase-only SLM sequence compiler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:prebuilt": "node scripts/build-wasm.mjs --prebuilt",
    "build:lib": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:lib && vite build",
    "test": "npm run build:wasm && npm run build:lib && node --test test/*.test.js && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "build:web": "npm run build:wasm && vite build",
    "dev": "npm run build:wasm && vite",
    "preview": "vite preview",
    "deploy": "npm run build:web && wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "vue": "^3.5.41"
  }
}
